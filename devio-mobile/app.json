{
  "expo": {
    "name": "DEVIO Mobile",
    "slug": "devio-mobile",
    "version": "2.11.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F3652"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.deviomx.app",
      "buildNumber": "100",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "DEVIO te notifica sobre el estado de tus pagos, avances de obra y documentos de tu propiedad.",
        "NSPhotoLibraryUsageDescription": "DEVIO permite adjuntar fotografías de avance de obra y comprobantes de pago.",
        "NSCameraUsageDescription": "DEVIO permite tomar fotografías para documentar avances de obra.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.devio.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F3652",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#1F3652"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "0f08c9cd-c185-4809-a9da-4fc34f3de77b"
      }
    }
  }
}
